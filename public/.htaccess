# ==============================================================================
# IEEE RAS Connect - Apache & cPanel Production Configuration
# Domain: https://connect.ras.ieeekerala.org/
# ==============================================================================

# 1. Disable Directory Indexing & Directory Listing (Security)
Options -Indexes -MultiViews

# 2. Block Hidden Files (.env, .git, .htaccess etc.)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Block Sensitive Extensions
<FilesMatch "\.(env|log|bak|sql|sh|git|md|yml|yaml|config|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 4. Restrict HTTP Request Methods to Safe Operations
<LimitExcept GET POST HEAD OPTIONS>
    Order Allow,Deny
    Deny from all
</LimitExcept>

# 5. Enterprise HTTP Security Headers
<IfModule mod_headers.c>
    # Protect against MIME sniffing
    Header set X-Content-Type-Options "nosniff"

    # Protect against Clickjacking
    Header set X-Frame-Options "SAMEORIGIN"

    # Enable XSS Filter
    Header set X-XSS-Protection "1; mode=block"

    # Control Referrer Information for Privacy and SEO Attribution
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Enforce HTTPS HSTS (1 year)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

    # Disable unused hardware API access
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # Content Security Policy (allows backend API connection)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://connect.ras.ieeekerala.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://rasconnect-v4sc.vercel.app https://ras-day.vercel.app https://connect.ras.ieeekerala.org; frame-ancestors 'self';"
</IfModule>

# 6. Gzip Compression for Performance (Boosts Google PageSpeed & SEO)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml font/woff2 font/woff
</IfModule>

# 7. Browser Caching (Speeds up repeat page loads)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 8. SEO Routing & Clean URLs
RewriteEngine On
RewriteBase /

# Force HTTPS Redirect
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force Trailing Slash on directories (SEO Canonical Structure)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ /$1/ [L,R=301]

# Serve Existing Static Files & Directories Directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean HTML Resolution: Check for file.html if requested without extension
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ /$1.html [L]

# Clean Directory Index: Check for directory/index.html
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*)$ /$1/index.html [L]

# Fallback to index.html for Single-Page Dynamic Routes
RewriteRule ^ index.html [L]
